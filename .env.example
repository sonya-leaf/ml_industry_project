# Example environment for llm.py (gitignored). Copy to `.env` and fill in real values.
# Never commit real secrets — this file is committed as a template only.

# Qwen endpoint and key for the agent model (llm.py OpenAIBackend).
QWEN_ENDPOINT=https://...
QWEN_API_KEY=...

# Optional: the LLM-as-a-judge (llm_judge.py) talks to a local Ollama. Override the
# endpoint/timeouts if you do not run it on the default localhost:11434.
# OLLAMA_ENDPOINT=http://localhost:11434/api/chat
# OLLAMA_TIMEOUT=300
# OLLAMA_MAX_RETRIES=2